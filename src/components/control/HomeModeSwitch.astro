---
import { url } from "@utils/url-utils";

interface Props {
	mode: "academic" | "blog";
	compact?: boolean;
}

const { mode, compact = false } = Astro.props;
const isBlog = mode === "blog";
const target = isBlog ? url("/") : url("/blog/");
const targetName = isBlog ? "Academic" : "Blog";
const currentName = isBlog ? "Blog" : "Academic";
const accessibleHint = `Currently on the ${currentName} homepage. Switch to the ${targetName} homepage`;
---

<a
	href={target}
	class:list={["home-mode-switch", { compact }]}
	data-current-mode={mode}
	data-testid="home-mode-switch"
	data-no-swup="true"
	role="switch"
	aria-checked={isBlog ? "true" : "false"}
	aria-label={accessibleHint}
	title={accessibleHint}
>
	<span class="mode-label" aria-hidden="true">
		<span>{currentName}</span>
		<span class="mode-arrow">→</span>
		<span>{targetName}</span>
	</span>
	<span class="switch-track" aria-hidden="true">
		<span class="switch-knob"></span>
	</span>
</a>

<style>
	.home-mode-switch {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.35rem 0.55rem 0.35rem 0.7rem;
		border: 1px solid color-mix(in srgb, currentColor 14%, transparent);
		border-radius: 999px;
		font-size: 0.74rem;
		font-weight: 700;
		line-height: 1;
		white-space: nowrap;
		color: inherit;
		background: color-mix(in srgb, var(--card-bg, white) 82%, transparent);
		box-shadow: 0 8px 24px rgb(15 23 42 / 8%);
		transition: transform 180ms ease, background-color 180ms ease,
			border-color 180ms ease;
	}

	.home-mode-switch:hover {
		transform: translateY(-1px);
	}

	.home-mode-switch:active {
		transform: scale(0.97);
	}

	.mode-label {
		display: inline-flex;
		align-items: center;
		gap: 0.28rem;
	}

	.mode-arrow {
		color: color-mix(in srgb, currentColor 48%, transparent);
		font-weight: 600;
	}

	.switch-track {
		position: relative;
		display: block;
		width: 2.55rem;
		height: 1.48rem;
		border-radius: 999px;
		background: #d7dce4;
		box-shadow: inset 0 0 0 1px rgb(15 23 42 / 7%);
		transition: background-color 260ms ease;
	}

	.switch-knob {
		position: absolute;
		top: 0.16rem;
		left: 0.16rem;
		width: 1.16rem;
		height: 1.16rem;
		border-radius: 50%;
		background: white;
		box-shadow: 0 2px 6px rgb(15 23 42 / 28%);
		transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
	}

	[data-current-mode="blog"] .switch-track {
		background: #34c759;
	}

	[data-current-mode="blog"] .switch-knob {
		transform: translateX(1.07rem);
	}

	.compact .mode-label {
		display: none;
	}

	.compact {
		padding-left: 0.35rem;
	}

	@media (max-width: 40rem) {
		.home-mode-switch .mode-label {
			display: none;
		}

		.home-mode-switch {
			padding-left: 0.35rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.home-mode-switch,
		.switch-track,
		.switch-knob {
			transition: none;
		}
	}
</style>
